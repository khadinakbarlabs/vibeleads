# ─────────────────────────────────────────────────────────────────────────────
# VibeLeads — env template. Copy to .env.local and fill in.
# .env.local is git-ignored. Never commit real secrets.
#
# `/capabilities/health` shows the live state of every key listed below.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (project: vibeleads) ────────────────────────────────────────────
# Required — frontend SSR + RLS-scoped queries.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for webhook handlers + admin operations (cron sweep, refunds).
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic — AI router + normalizer (REQUIRED for green health) ──────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_OPUS=claude-opus-4-7

# ── Apify — actor runs (REQUIRED for green health) ──────────────────────────
APIFY_TOKEN=

# Prospecting workspace OAuth. Use the registered HTTPS callback origin.
# Generate a 32-byte base64url key and keep it in the deployment secret store.
APIFY_OAUTH_ORIGIN=https://your-domain.example
APIFY_OAUTH_CLIENT_ID=
APIFY_WORKSPACE_SESSION_KEY=
# Required for public Apify campaigns. Generate 32+ random characters and use
# the same value in the per-run callback URL generated by the app.
APIFY_WEBHOOK_SECRET=

# Apify actor IDs — defaults are this workspace's actors. Override only if
# you've forked them. See `lib/apify/actors.ts` for input schemas.
ACTOR_GOOGLE_MAPS_ID=khadinakbar/google-maps-leads-scraper
ACTOR_GOOGLE_SERP_ID=khadinakbar/scrape-google-serp
ACTOR_CONTACT_FORM_ID=khadinakbar/contact-details-scraper
ACTOR_GMAPS_LEADS_ID=khadinakbar/google-maps-leads-scraper
# LinkedIn jobs scraper — powers the hiring_intent intent.
ACTOR_LINKEDIN_JOBS_ID=khadinakbar/linkedin-jobs-scraper
# Product Hunt scraper — powers the producthunt intent + ph.* strategies.
ACTOR_PRODUCTHUNT_ID=khadinakbar/producthunt-scraper-pro
# LinkedIn profile + email scraper — powers the talent_sourcing intent.
# Search-mode pulls profiles by job-title / industry / location;
# URL-mode pulls explicit profiles. Optional public-email enrichment.
ACTOR_LINKEDIN_PROFILES_ID=khadinakbar/linkedin-profile-email-scraper
# Google Maps reviews scraper — powers the reviews_gmaps intent.
# Per-place pull; takes Maps URLs / place IDs / business names.
ACTOR_GMAPS_REVIEWS_ID=khadinakbar/google-maps-reviews-scraper
# Trustpilot reviews scraper — powers the reviews_trustpilot intent.
# Per-domain or per-company-name pull.
ACTOR_TRUSTPILOT_REVIEWS_ID=khadinakbar/trustpilot-reviews-scraper
# Apify enrichment actors (deep website + universal lead-finder).
ACTOR_WEBSITE_ENRICH_ID=khadinakbar/bulk-website-contact-extractor
ACTOR_COMPANY_ENRICH_ID=khadinakbar/universal-lead-finder

# ── Outreach gating ─────────────────────────────────────────────────────────
# Optional native business discovery.
SERPAPI_KEY=

# ── PageSpeed — gates the slow-website filter family ────────────────────────
# Free Google API, 25k req/day. Unlocks redesign.local_slow_* strategies +
# the PageSpeed enrichment task (enrich.pagespeed). Get one at
# https://console.cloud.google.com (enable the PSI API).
PAGESPEED_API_KEY=

# ── Email validation — Phase 3. Provider auto-picked. ───────────────────────
# Priority: NeverBounce > ZeroBounce > EmailListVerify > syntax-only fallback.
# /capabilities/health surfaces which one is the active validator.
NEVERBOUNCE_API_KEY=
ZEROBOUNCE_API_KEY=
EMAILLISTVERIFY_API_KEY=

# ── Stripe — billing (Phase 5, test mode for dev) ───────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email send — Phase 6 (Resend) ───────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=notifications@vibeleads.app

# ── Encryption — at-rest credentials for stored integrations ────────────────
# 32-byte hex (64 chars) AES-256-GCM master key. Optional in dev (falls back
# to plaintext with a warning). Required in production.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Cron route protection ───────────────────────────────────────────────────
# 32+ char random string. The /api/cron/sweep-runs route refuses requests
# without a matching Authorization: Bearer header.
CRON_SECRET=replace-with-32-char-random-string

# ── Cost guards ─────────────────────────────────────────────────────────────
# Wall-clock seconds before the poll auto-aborts a runaway run. Default 600s.
MAX_RUNTIME_SECS=600
# Per-account daily credit ceiling (5000 ≈ $5). Per-account overrides live
# on accounts.daily_credit_cap (Settings → Limits writes to that column).
DEFAULT_DAILY_CREDIT_CAP=5000
# Pre-flight confirm threshold — runs above this surface a "big run" gate.
PREFLIGHT_CONFIRM_THRESHOLD_CREDITS=200

# ── Provider selection ──────────────────────────────────────────────────────
# Google Maps scraper. "apify" (default) routes local_business runs to the
# Apify actor; "native" uses our SerpAPI-backed scraper (~70% cheaper,
# fully synchronous, no email enrichment). Affects ONLY local_business —
# gmaps_leads + other intents stay on Apify regardless.
MAPS_PROVIDER=apify

# ── Observability (optional) ────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
